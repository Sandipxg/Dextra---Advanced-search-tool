# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL, e.g. Neon)
DATABASE_URL=postgres://user:password@localhost:5432/dextra

# Auth (Better Auth) — secret must be at least 32 characters
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# LLM (template selection)
ANTHROPIC_API_KEY=

# SERP providers — at least one is required (provider choice: T-001)
SERPER_API_KEY=
SERPAPI_API_KEY=
BRAVE_API_KEY=
