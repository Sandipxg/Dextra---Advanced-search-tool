# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL, e.g. Neon)
DATABASE_URL=postgres://user:password@localhost:5432/dextra
# Separate database for API tests (created and migrated by the test setup)
DATABASE_TEST_URL=postgres://user:password@localhost:5432/dextra_test

# Auth (Better Auth) — secret must be at least 32 characters
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# GitHub sign-in (optional; enabled when both are set)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Web app origin (CORS) and API port
WEB_ORIGIN=http://localhost:5173
PORT=3000

# LLM (template selection; optional, rule-based picks without it)
ANTHROPIC_API_KEY=

# SERP providers — at least one is required (provider choice: T-001)
SERPER_API_KEY=
SERPAPI_API_KEY=
BRAVE_API_KEY=
